// Nakconel CBT Platform — Database Schema
// Phase 1: Auth + Registration entities. More entities (Exam, Question, Attempt, etc.)
// will be added in later phases without breaking these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
  exams     Exam[]
  questions Question[]

  @@map("courses")
}

// Phase 5 scope: the Question Bank. Kept intentionally simple (single
// correct answer, per-course, no categories/tags yet) — the exam engine
// (Phase 6) only needs a pool of active questions per course to draw from.
model Question {
  id           String   @id @default(cuid())
  courseId     String
  examId       String?
  course       Course   @relation(fields: [courseId], references: [id])
  exam         Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  text         String
  options      String[] // 2+ answer options, in display order
  correctIndex Int // index into `options` of the correct answer
  active       Boolean  @default(true) // inactive questions are excluded from the exam-ready count
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attemptQuestions AttemptQuestion[]

  @@index([courseId])
  @@map("questions")
}

// Phase 2 scope: the exam's schedule/config and the status shown on the
// student dashboard. Question bank, attempts, and scoring are later phases —
// this model is deliberately built so those can attach to it without
// reshaping what's here.
model Exam {
  id             String    @id @default(cuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])
  name           String // e.g. "Test 1", "Final Test"
  order          Int       @default(0) // display order within the course
  numQuestions   Int
  durationMinutes Int
  passingScore   Int       @default(50) // percentage
  instructions   String?
  published      Boolean   @default(false)
  shuffleQuestions Boolean @default(true)
  shuffleOptions Boolean   @default(true)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  questions      Question[]
  attempts       ExamAttempt[]

  @@index([courseId])
  @@map("exams")
}

model Student {
  id           String   @id @default(cuid())
  studentId    String   @unique // e.g. NAK-2026-001
  fullName     String
  email        String   @unique
  phone        String
  age          Int
  gender       String
  address      String
  socialMedia  String?
  passwordHash String
  status       String   @default("active") // active | disabled
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attempts     ExamAttempt[]

  // Phase 11 — identity verification. Captured from the student's first
  // consented exam-camera session (an "approved live capture" per the
  // spec), not at registration — nothing here until they actually sit an
  // exam. Descriptor is a face-recognition embedding (128 floats, JSON
  // encoded), used only to compare against future attempts; it is not a
  // photo and cannot be reversed into one. Both fields are deletable by an
  // admin at any time (see the student detail page) per the spec's
  // retention/deletion requirement.
  verificationPhoto      String? // small base64 JPEG data URL
  verificationDescriptor String? // JSON-encoded Float32Array
  verificationCapturedAt DateTime?

  @@index([courseId])
  @@map("students")
}

// Guarantees unique, gapless-per-year, race-safe Student ID generation.
// One row per registration year; count is incremented inside a DB transaction.
model StudentIdCounter {
  year  Int @id
  count Int @default(0)

  @@map("student_id_counters")
}

model Admin {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // room to add roles later (e.g. super_admin)
  status       String   @default("active")
  createdAt    DateTime @default(now())

  @@map("admins")
}

// Audit log — started in Phase 1 for auth events, extended in later phases
// to cover exam activity per the platform spec.
model AuditLog {
  id        String   @id @default(cuid())
  actorType String // student | admin | system
  actorId   String?
  action    String // e.g. "student.register", "student.login", "admin.login"
  detail    String?
  ip        String?
  attemptId String? // set for exam-monitoring events, so an attempt's
  // detail page can show exactly what was flagged during it — not stored
  // as a relation (deliberately survives an attempt being reset/deleted,
  // since the audit trail should outlive the row it describes)
  createdAt DateTime @default(now())

  @@index([actorType, actorId])
  @@index([attemptId])
  @@map("audit_logs")
}

model ExamAttempt {
  id           String            @id @default(cuid())
  examId       String
  studentId    String
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       String            @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | TIMED_OUT | TERMINATED
  startedAt    DateTime          @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  score        Int?
  passed       Boolean?
  questions    AttemptQuestion[]

  // Phase 10 — one active session per attempt. sessionId is a random value
  // the browser tab generates and re-sends on every heartbeat; a second
  // tab/device with a different sessionId is refused while the first one's
  // heartbeat is still recent (see IDs and staleness window in the API).
  activeSessionId String?
  activeSessionAt DateTime?

  // Phase 12 — admin intervention on a live attempt. pendingWarning is
  // read-once: delivered on the next heartbeat, then cleared. endedBy and
  // endReason record who/why when an admin terminates or force-submits,
  // distinct from a normal student submission or a timeout.
  pendingWarning  String?
  endedBy         String? // "student" | "timeout" | "admin:<adminId>"
  endReason       String?

  @@unique([examId, studentId])
  @@index([studentId, status])
  @@map("exam_attempts")
}

model AttemptQuestion {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])
  position      Int
  text          String
  options       String[]
  correctIndex  Int
  selectedIndex Int?

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([questionId])
  @@map("attempt_questions")
}
