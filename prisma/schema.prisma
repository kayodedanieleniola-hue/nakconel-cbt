// Nakconel CBT Platform — Database Schema
// Phase 1: Auth + Registration entities. More entities (Exam, Question, Attempt, etc.)
// will be added in later phases without breaking these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@map("courses")
}

model Student {
  id           String   @id @default(cuid())
  studentId    String   @unique // e.g. NAK-2026-001
  fullName     String
  email        String   @unique
  phone        String
  age          Int
  gender       String
  address      String
  socialMedia  String?
  passwordHash String
  status       String   @default("active") // active | disabled
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId])
  @@map("students")
}

// Guarantees unique, gapless-per-year, race-safe Student ID generation.
// One row per registration year; count is incremented inside a DB transaction.
model StudentIdCounter {
  year  Int @id
  count Int @default(0)

  @@map("student_id_counters")
}

model Admin {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // room to add roles later (e.g. super_admin)
  status       String   @default("active")
  createdAt    DateTime @default(now())

  @@map("admins")
}

// Audit log — started in Phase 1 for auth events, extended in later phases
// to cover exam activity per the platform spec.
model AuditLog {
  id        String   @id @default(cuid())
  actorType String // student | admin | system
  actorId   String?
  action    String // e.g. "student.register", "student.login", "admin.login"
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorType, actorId])
  @@map("audit_logs")
}
