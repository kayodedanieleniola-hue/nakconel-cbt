# Neon Postgres — pooled connection (used by the running app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Neon Postgres — direct/unpooled connection (used to create/update tables on deploy)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Long random secret used to sign session cookies. Generate one at
# https://generate-secret.vercel.app/48 or any password generator (48+ chars).
AUTH_SECRET="replace-with-a-long-random-string"

# Secret you make up yourself — protects the one-time /api/setup URL.
SETUP_SECRET="replace-with-another-random-string"

# Optional — if set, /api/setup will also create your first admin account.
SEED_ADMIN_EMAIL="admin@nakconel.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
SEED_ADMIN_NAME="Admin"
